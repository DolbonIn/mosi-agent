# Copy to .env and fill with a ROTATED key. Never commit .env. Never paste keys in chat.
# LLM (OpenGateway, OpenAI-compatible)
OPENGATEWAY_API_KEY=
OPENGATEWAY_BASE_URL=https://apis.opengateway.ai/v1
OPENGATEWAY_MODEL=deepseek/deepseek-v4.1-flash-ultrafast

# Credential vault master key: 32 random bytes, base64.
# Generate with: bun -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=

# Messenger integrations (official APIs only; filled per phase)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
KAKAO_REST_API_KEY=
